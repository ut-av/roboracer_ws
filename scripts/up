#!/bin/bash
#
# Launch a plan from a GUARANTEED-CLEAN, PRE-BUILT state.
#
# Equivalent to `airfield project up <plan>`, but first:
#   1. removes anything left over from a prior unclean teardown that would
#      otherwise make panes fail:
#        - orphaned airfield containers (a leftover vnc holding :9 breaks rviz2/gui)
#        - stale :9 socket/lock
#        - a stuck Argus camera session (causes orin_rp2_csi "Captured image is
#          invalid or empty")
#   2. runs the build-once step (scripts/build) so the shared ~/workspace/install
#      is populated before any node launches.
#
# Why (2) lives here: airfield's tmux template is intentionally generic and does
# NOT build (that would couple the shared tool to ROS/colcon). The "build once,
# launch many" model is a roboracer concern, so it lives in this project script.
# scripts/build is serial + parallelism-capped (OOM-safe) and colcon is
# incremental, so a warm re-run is cheap. Panes then only source (via the
# container's ~/.profile) and launch. See scripts/build for details.
#
# Usage: scripts/up [plan]   (default plan: navstack)
#
set -uo pipefail
PLAN="${1:-navstack}"
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

echo "[up] clearing any orphaned containers / stale display / camera state..."
ids="$(docker ps -q --filter name=airfield-run-)"
[ -n "$ids" ] && docker stop -t 3 $ids >/dev/null 2>&1 || true
docker rm -f $(docker ps -aq --filter name=airfield-run-) >/dev/null 2>&1 || true
rm -f /tmp/.X11-unix/X9 /tmp/.X9-lock 2>/dev/null || true
# Clear any stale CSI camera capture session (no consumer is running yet).
sudo -n systemctl restart nvargus-daemon 2>/dev/null || true

echo "[up] build-once: ensuring shared workspace is built (serial, OOM-safe)..."
if ! "$SCRIPT_DIR/build"; then
    echo "[up] build failed; not launching." >&2
    exit 1
fi

echo "[up] launching plan: $PLAN"
exec airfield project up "$PLAN"
